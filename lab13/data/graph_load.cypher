// ЛР13 · Знання, витягнуті з текстів, з provenance. Завантаження: python scripts/load_neo4j.py
CREATE CONSTRAINT xentity_id IF NOT EXISTS FOR (e:XEntity) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT xdoc_id IF NOT EXISTS FOR (d:XDocument) REQUIRE d.id IS UNIQUE;
MERGE (d:XDocument {id: 'gen01'}) SET d.title = 'Паспорти підстанцій мережі', d.type = 'register', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen01_substation_passports.md';
MERGE (d:XDocument {id: 'gen02'}) SET d.title = 'Картки моделей прогнозування', d.type = 'model_card', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen02_model_cards.md';
MERGE (d:XDocument {id: 'gen03'}) SET d.title = 'Реєстр споживачів', d.type = 'register', d.sensitivity = 'restricted', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen03_consumer_register.md';
MERGE (d:XDocument {id: 'gen04'}) SET d.title = 'Реєстр лічильників AMI', d.type = 'register', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen04_meter_register.md';
MERGE (d:XDocument {id: 'gen05'}) SET d.title = 'Журнал прогнозів', d.type = 'forecast_log', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen05_forecast_log.md';
MERGE (d:XDocument {id: 'gen06'}) SET d.title = 'Довідник погодних умов навчальних періодів', d.type = 'register', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen06_weather_reference.md';
MERGE (d:XDocument {id: 'gen07'}) SET d.title = 'Зони відповідальності диспетчерів', d.type = 'register', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/generated/gen07_dispatcher_zones.md';
MERGE (d:XDocument {id: 'kb01'}) SET d.title = 'Глосарій предметної області «Прогнозування енергоспоживання»', d.type = 'glossary', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb01_glossary.md';
MERGE (d:XDocument {id: 'kb02'}) SET d.title = 'Методи прогнозування електричного навантаження', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb02_forecasting_methods.md';
MERGE (d:XDocument {id: 'kb03'}) SET d.title = 'Метрики якості прогнозу навантаження', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb03_forecast_metrics.md';
MERGE (d:XDocument {id: 'kb04'}) SET d.title = 'Вплив погоди на енергоспоживання', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb04_weather_impact.md';
MERGE (d:XDocument {id: 'kb05'}) SET d.title = 'Інтелектуальні лічильники AMI та якість вимірювань', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb05_ami_meters.md';
MERGE (d:XDocument {id: 'kb06'}) SET d.title = 'Регламент дій диспетчера при перевантаженні підстанції', d.type = 'regulation', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb06_overload_regulation.md';
MERGE (d:XDocument {id: 'kb07'}) SET d.title = 'Політика якості даних для навчання моделей прогнозування', d.type = 'policy', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb07_data_quality_policy.md';
MERGE (d:XDocument {id: 'kb08'}) SET d.title = 'Порядок перенавчання моделей прогнозування', d.type = 'procedure', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb08_retraining_procedure.md';
MERGE (d:XDocument {id: 'kb09'}) SET d.title = 'Онтологія предметної області та її перенесення в граф знань', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb09_ontology_overview.md';
MERGE (d:XDocument {id: 'kb10'}) SET d.title = 'Класифікація конфіденційності та правила доступу до бази знань', d.type = 'policy', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb10_access_policy.md';
MERGE (d:XDocument {id: 'kb11'}) SET d.title = 'Часті питання диспетчерів', d.type = 'faq', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb11_dispatcher_faq.md';
MERGE (d:XDocument {id: 'kb12'}) SET d.title = 'Топологія живлення та каскадні аварії', d.type = 'kb_article', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb12_cascade_topology.md';
MERGE (d:XDocument {id: 'kb13'}) SET d.title = 'Архітектура Domain Knowledge Hub', d.type = 'kb_article', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb13_hub_architecture.md';
MERGE (d:XDocument {id: 'kb14'}) SET d.title = 'Інструкція з обробки несправностей лічильників', d.type = 'procedure', d.sensitivity = 'internal', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb14_meter_maintenance.md';
MERGE (d:XDocument {id: 'kb15'}) SET d.title = 'Журнал інцидентів диспетчерської служби (вересень — жовтень 2026)', d.type = 'incident_log', d.sensitivity = 'restricted', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/lab10/data/raw/kb/kb15_incident_log.md';
MERGE (d:XDocument {id: 'prj10'}) SET d.title = 'ЛР12: OLAP-запити сховища енергоспоживання — питання та інтерпретації', d.type = 'project_doc', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/tree/lab12/lab12/sql/olap';
MERGE (d:XDocument {id: 'prj11'}) SET d.title = 'СР12: зіркова схема точності прогнозів добового споживання', d.type = 'project_doc', d.sensitivity = 'public', d.source_url = 'https://github.com/AlinaPavlenk18/krkm-labs/blob/main/sr12/docs/star_design.md';
