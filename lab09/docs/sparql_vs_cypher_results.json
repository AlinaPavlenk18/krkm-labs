  "id": "S2",
  "cq": "KQ8",
  "title": "Підстанції з необов'язковим диспетчером (OPTIONAL)",
  "sparql": "PREFIX :     <http://www.semanticweb.org/energy-forecasting#>\nPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT ?name ?region ?dispatcher ?shift\nWHERE {\n  ?s a :Substation ;\n     skos:prefLabel ?name ;\n     :region ?region .\n  OPTIONAL { ?s :managedByDispatcher ?dispatcher .\n             ?dispatcher :shift ?shift . }\n}\nORDER BY ?name",
  "cypher": "MATCH (s:Substation)-[:LOCATED_IN]->(r:Region)\nOPTIONAL MATCH (d:Dispatcher)-[:MANAGES]->(s)\nRETURN s.name AS name, r.name AS region, d.id AS dispatcher, d.shift AS shift\nORDER BY name",
