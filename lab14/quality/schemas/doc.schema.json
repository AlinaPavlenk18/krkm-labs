{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Документ корпусу бази знань (ЛР10–ЛР14)",
  "type": "object",
  "required": ["doc_id", "title", "type", "date", "sensitivity", "source_url", "license", "origin", "sections"],
  "properties": {
    "doc_id": {"type": "string", "pattern": "^(kb|gen|prj)[0-9]{2}$"},
    "title": {"type": "string", "minLength": 3},
    "type": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "sensitivity": {"enum": ["public", "internal", "restricted"]},
    "source_url": {"type": "string", "pattern": "^https://"},
    "license": {"type": "string", "minLength": 3},
    "origin": {"type": "string", "minLength": 3},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["section", "text"],
                "properties": {"section": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}}
    }
  }
}
