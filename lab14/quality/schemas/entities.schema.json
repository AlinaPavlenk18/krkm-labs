{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Реєстр сутностей після entity resolution (ЛР14, Р2)",
  "type": "object",
  "required": ["created", "stats", "entities"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "type", "preferred_name", "n_members", "members", "merge_evidence"],
        "properties": {
          "members": {"type": "array", "minItems": 1,
                      "items": {"type": "object", "required": ["rid", "source", "name", "provenance"],
                                "properties": {"source": {"enum": ["graph", "text"]}}}},
          "merge_evidence": {"type": "array",
                             "items": {"type": "object", "required": ["a", "b", "score", "features"]}}
        }
      }
    }
  }
}
